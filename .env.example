# General
NODE_ENV=development
DOMAIN=localhost
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AGENT_URL=http://agent:8000
INTERNAL_API_KEY=change-me

# Auth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
JWT_SECRET=change-me
TOKEN_ENCRYPTION_KEY=change-me-32-bytes

# GitHub App (Day 5)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem
GITHUB_APP_SLUG=

# Database and queue
MONGODB_URI=mongodb://mongo:27017/codescout?directConnection=true
REDIS_URL=redis://redis:6379

# LLM provider (check build.nvidia.com catalog for current model IDs)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_FAST_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
RERANK_MODEL=
LLM_RPM_LIMIT=35
LLM_MAX_RETRIES=5

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Limits
MAX_REPO_SIZE_MB=50
MAX_FILES_PER_REPO=3000
MAX_AGENT_STEPS=15
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
DAILY_RUNS_PER_USER=20
EDIT_ALLOWLIST=

# Production domain (Day 6)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

